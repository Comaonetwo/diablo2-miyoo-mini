+namespace d2d::client {
+inline void draw_corner_hud(std::vector<std::uint8_t>& f,const Scene& scene,const View& view,bool map_open,int merc_life,int merc_max){
+ const auto& pal=scene.act_pal.entries().empty()?scene.pal:scene.act_pal;
+ const auto fill=[&](int x,int y,int w,int h,std::array<std::uint8_t,3> c){for(int yy=y;yy<y+h;++yy)for(int xx=x;xx<x+w;++xx){if(xx<0||xx>=800||yy<0||yy>=600)continue;auto*p=f.data()+(yy*800+xx)*4;for(int k=0;k<3;++k)p[k]=c[k];p[3]=255;}};
+ const bool hired=view.header.merc_seed!=0;constexpr int top=12;
