+void drop_previous_poses(const Scene& scene) {
+    // Every lookup pins its pose to this frame before returning Unit pointers.
+    // At a cache miss, discard unpinned old poses before allocating a new DCC
+    // (especially a boss death), rather than waiting until after rendering.
+    // Avoid discarding every other NPC when one actor changes walking pose.
+    // That caused repeated MPQ reads/decoding in busy towns. Keep a bounded
+    // warm cache, while current-frame Unit pointers remain pinned.
+    constexpr std::size_t limit=3*1024*1024;
+    std::size_t total=0;for(const auto& [key,a]:scene.composites)total+=a.storage_bytes();for(const auto& [key,a]:scene.npc_anims)total+=a.storage_bytes();
