+    const auto& unit=owner&&merc?merc->unit:player;
+    for(std::size_t i=0;i<list.size();++i){const auto& p=list[i];if(!eligible(p))continue;bool prior=false;int chance=0;
+        for(std::size_t j=0;j<list.size();++j)if(eligible(list[j])&&list[j].skill==p.skill&&list[j].level==p.level){prior|=j<i;chance+=list[j].chance;}
