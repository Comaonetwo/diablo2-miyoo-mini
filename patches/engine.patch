+void Fight::item_event(int event,int target,std::uint32_t,int owner,int pet_id){
+    if(owner<0||owner>2||(owner==2&&item_proc_depth>0))return;
+    if(owner==2){
+        if(pet_id<0)pet_id=damage_pet_id;
+        const auto source=std::ranges::find_if(pets,[&](const Pet& pet){return pet.monster.id==pet_id&&pet.where==level;});
+        if(source==pets.end()||!source->shadow_gear||(!source->monster.alive()&&event!=OnDeath))return;
+        const bool projected=casting_summon&&damage_actor==2&&damage_pet_id==pet_id;
+        const auto& list=projected?casting_summon->procs:source->shadow_gear->procs;if(list.empty())return;
+        const int hand=projected?casting_summon->hand:source->monster.swing_mode=="A2"?5:4;
