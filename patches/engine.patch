+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <chrono>
+#include <cstdint>
+namespace d2d::dcc {
+struct DecodeProfile { bool enabled=false;std::uint64_t calls=0,ns=0; };
+inline thread_local DecodeProfile decode_profile;
+#ifndef D2D_MIYOO
+// Frozen-frame developer comparisons; absent from the console decoder.
+inline thread_local bool legacy_pixel_decode=false;
+inline thread_local bool legacy_scratch_init=false;
+#endif
+struct DirectionDecodeTimer {
+ bool active=decode_profile.enabled;
+ std::chrono::steady_clock::time_point start;
+ DirectionDecodeTimer(){if(active){start=std::chrono::steady_clock::now();++decode_profile.calls;}}
+ ~DirectionDecodeTimer(){if(active)decode_profile.ns+=std::uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now()-start).count());}
+};
+}
diff --git a/components/game/merc_inventory.hpp b/components/game/merc_inventory.hpp
new file mode 100644
index 0000000..542e07b
--- /dev/null
+++ b/components/game/merc_inventory.hpp
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include "item_text.hpp"
+#include "inventory.hpp"
+namespace d2d::game {
+enum class MercItemResult { Ok, NoMerc, Dead, TooFar, Slot, Type, Identify, Level, Strength, Dexterity };
+inline int merc_act(const GameData& data, const d2d::d2s::Header& header) {
+    for(const auto& h:data.rules.hirelings)if(h.version==100&&h.id==header.merc_type)return h.act;
+    return 0;
+}
+inline bool merc_slot(const GameData& data,const d2d::d2s::Header& header,int slot){
+    using namespace d2d::d2s::body_location;
+    return slot==kHead||slot==kTorso||slot==kRightArm||(slot==kLeftArm&&merc_act(data,header)==3);
+}
+inline d2d::rules::Wearer merc_wearer(const GameData& data,const d2d::d2s::Header& header,const std::vector<d2d::d2s::Item>& items,int excluding=0){
+    using namespace d2d::d2s;
+    const auto base=d2d::rules::merc_stats(data.rules,header.merc_type,header.merc_exp);
+    d2d::rules::Wearer out{-1,base.str,base.dex,base.level};
+    const auto add=[&](const auto& props){for(const auto& p:props){if(p.stat==kStr)out.str+=int(p.value);if(p.stat==kDex)out.dex+=int(p.value);}};
+    std::vector<Item> active;for(const auto& item:items)if(item.location==item_location::kEquipped&&item.slot!=excluding)active.push_back(item);
+    for(const auto& item:active){add(item.props);for(const auto& gem:item.socketed_items)add(socket_props(data,item,gem));add(set_bonus_props(data,active,item));}
+    return out;
+}
+inline MercItemResult merc_can_equip(const GameData& data,const d2d::d2s::Header& header,const std::vector<d2d::d2s::Item>& items,const d2d::d2s::Item& item,int slot){
+    using namespace d2d::d2s;
+    if(!header.expansion()||!header.merc_seed)return MercItemResult::NoMerc;
+    if(!merc_slot(data,header,slot))return MercItemResult::Slot;
+    const int act=merc_act(data,header);const auto* info=d2d::rules::info_of(data.rules,item);
+    if(!info)return MercItemResult::Type;
+    const auto type=data.rules.types.find(info->type);
+    if(type==data.rules.types.end())return MercItemResult::Type;
+    const auto cls=d2d::rules::type_class(data.rules,info->type);
+    if(!cls.empty()&&!(act==5&&slot==body_location::kHead&&cls=="bar"))return MercItemResult::Type;
+    const auto is=[&](const char* t){return d2d::rules::type_is(data.rules,info->type,t);};
+    bool allowed=false;
+    if(slot==body_location::kHead||slot==body_location::kTorso)allowed=info->kind==1&&(type->second.body[0]==slot||type->second.body[1]==slot);
+    else if(slot==body_location::kLeftArm)allowed=act==3&&is("shld");
+    else if(slot==body_location::kRightArm){
+        if(act==1)allowed=is("bow");
+        if(act==2)allowed=is("spea")||is("pole")||is("jave");
+        if(act==3)allowed=is("swor")&&!info->two_handed;
+        if(act==5)allowed=is("swor");
+    }
+    if(!allowed)return MercItemResult::Type;
+    if(!item.identified&&item.quality>=4)return MercItemResult::Identify;
+    const auto wearer=merc_wearer(data,header,items,slot);
+    if(wearer.lvl<required_level(data,item))return MercItemResult::Level;
+    const auto req=[&](int base){return d2d::rules::required_attribute(data.rules,item,base);};
+    if(wearer.str<req(info->req_str))return MercItemResult::Strength;
+    if(wearer.dex<req(info->req_dex))return MercItemResult::Dexterity;
+    return MercItemResult::Ok;
+}
+// One shared cursor: a rejected move changes neither owner nor item identity.
+inline MercItemResult merc_item_move(const GameData& data,const d2d::d2s::Header& header,std::vector<d2d::d2s::Item>& items,std::optional<d2d::d2s::Item>& held,int slot){
+    using namespace d2d::d2s;
+    if(!header.expansion()||!header.merc_seed)return MercItemResult::NoMerc;
+    if(header.merc_dead)return MercItemResult::Dead;
+    if(!merc_slot(data,header,slot))return MercItemResult::Slot;
+    auto it=std::ranges::find_if(items,[&](const Item& i){return i.location==item_location::kEquipped&&i.slot==slot;});
+    if(!held){if(it!=items.end())d2d::rules::pick_up(items,held,std::size_t(it-items.begin()));return MercItemResult::Ok;}
+    const auto result=merc_can_equip(data,header,items,*held,slot);if(result!=MercItemResult::Ok)return result;
+    if(it==items.end()){items.reserve(items.size()+1);items.push_back(std::move(*held));held.reset();it=items.end()-1;}
+    else{std::swap(*held,*it);held->location=item_location::kCursor;held->slot=0;}
+    it->location=item_location::kEquipped;it->slot=slot;it->panel=it->column=it->row=0;
+    return MercItemResult::Ok;
+}
+inline const char* merc_item_message(int code){
+    switch(MercItemResult(code)){
+    case MercItemResult::NoMerc:return "No mercenary hired";
+    case MercItemResult::Dead:return "Resurrect your mercenary first";
+    case MercItemResult::TooFar:return "Mercenary is too far away";
+    case MercItemResult::Slot:case MercItemResult::Type:return "This mercenary cannot use that item";
+    case MercItemResult::Identify:return "Identify the item first";
+    case MercItemResult::Level:return "Mercenary level is too low";
+    case MercItemResult::Strength:return "Not enough strength";
+    case MercItemResult::Dexterity:return "Not enough dexterity";
+    default:return "";
+    }
+}
+}
