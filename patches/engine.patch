+    if(base==0x147||base==0x148){stats.a1_min=stats.a2_min=stats.s1_min=std::min(lvl/2+1,lvl);stats.a1_max=stats.a2_max=stats.s1_max=lvl;return;}
+    if(base==0x162)return;stats.a1_min=stats.a1_max=stats.a2_min=stats.a2_max=stats.s1_min=stats.s1_max=0;
+    if(base==0x149){stats.poison_min=lvl;stats.poison_max=lvl*2;stats.poison_len=lvl*2;return;}
+    const int element=base==0x146?0:1;stats.elements[0]={element,100,lvl/2,3*lvl/2,0,"A1"};stats.elements[1]={element,100,lvl/2,3*lvl/2,0,"A2"};
+}
