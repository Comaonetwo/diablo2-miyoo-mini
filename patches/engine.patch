+    using namespace d2d::d2s;
+    const auto& pal=scene.act_pal.entries().empty()?scene.pal:scene.act_pal;
+    const auto fill=[&](int x,int y,int w,int h,std::array<std::uint8_t,3> rgb){
+        for(int yy=std::max(0,y);yy<std::min(600,y+h);++yy)for(int xx=std::max(0,x);xx<std::min(800,x+w);++xx){auto*p=f.data()+(yy*800+xx)*4;p[0]=rgb[0];p[1]=rgb[1];p[2]=rgb[2];p[3]=255;}
+    };
+    fill(80,60,320,432,{117,102,66});fill(83,63,314,426,{28,27,24});
+    const d2d::font::TextScaleScope scale(100);
+    const d2d::font::TextWeightScope weight(scene.use_readable());
+    const d2d::font::TextContrastScope contrast(true);
+    const d2d::font::PanelTextScope sharp(g_sharp_panel_text&&g_ui_scale>100,false);
+    const auto& font=scene.readable(scene.font);
+    const auto text=[&](std::string_view value,int x,int y,int width,int height=20,bool gold=false){
+        const auto fit=d2mini::fit_text(font,value,width,height,100,65,false);
+        const d2d::font::TextScaleScope fitted(fit.scale);
+        if(!fit.lines.empty())font.draw_tinted(f,800,600,pal,x+std::max(0,(width-font.ink_width(fit.lines[0]))/2),y,fit.lines[0],gold?220:235,gold?191:235,gold?127:235);
+    };
+    text("Mercenary",92,72,296,20,true);
+    if(!view.header.expansion()||!view.header.merc_seed){text("No mercenary hired",96,160,288);text("Visit a mercenary captain",96,190,288);return;}
+    const int act=d2d::game::merc_act(scene,view.header);
+    const auto wearer=d2d::game::merc_wearer(scene,view.header,view.merc_items);
+    const char* kind=act==1?"Rogue Scout":act==2?"Desert Mercenary":act==3?"Iron Wolf":act==5?"Barbarian":"Mercenary";
+    text(name.empty()?std::string_view(kind):name,92,98,296);
+    text(std::format("{}  /  Level {}",kind,wearer.lvl),92,121,296);
+    text(view.header.merc_dead?"Dead - visit a captain":std::format("Life  {} / {}",view.merc_sheet.life,view.merc_sheet.max_life),92,143,296);
+    const Item* hover=nullptr;std::array<int,4> hover_box{};
+    for(auto [slot,label]:{std::pair{body_location::kHead,"Helm"},std::pair{body_location::kTorso,"Armor"},std::pair{body_location::kRightArm,"Weapon"},std::pair{body_location::kLeftArm,"Shield"}}){
+        if(!d2d::game::merc_slot(scene,view.header,slot))continue;
+        const auto b=merc_panel_rect(slot);const bool over=mx>=b[0]&&mx<b[0]+b[2]&&my>=b[1]&&my<b[1]+b[3];
+        fill(b[0]-2,b[1]-2,b[2]+4,b[3]+4,over?std::array<std::uint8_t,3>{232,195,93}:std::array<std::uint8_t,3>{126,113,76});
+        fill(b[0],b[1],b[2],b[3],{5,5,5});
+        // Helm label goes beside its box, keeping the life line clear.
+        if(slot==body_location::kHead)text(label,116,182,84);
+        else text(label,b[0]-10,b[1]-24,b[2]+20);
+        const auto item=std::ranges::find_if(view.merc_items,[&](const Item& i){return i.location==item_location::kEquipped&&i.slot==slot;});
+        if(item==view.merc_items.end())continue;
+        if(const auto* sprite=scene.item_sprite(*item);sprite&&sprite->frames_per_direction()){
+            const auto& frame=sprite->frame(0,0);
+            blit_sprite(f,frame,scene.item_pal(*item,pal),b[0]+(b[2]-int(frame.width))/2,b[1]+(b[3]-int(frame.height))/2);
+        }
+        if(over){hover=&*item;hover_box=b;}
+    }
+    text(std::format("Str {}   Dex {}",wearer.str,wearer.dex),92,386,296);
+    text(std::format("Damage {}-{}   Defense {}",view.merc_sheet.min,view.merc_sheet.max,view.merc_sheet.def),92,407,296);
+    text(std::format("Resists  F:{}  L:{}  C:{}  P:{}",view.merc_sheet.res[0],view.merc_sheet.res[1],view.merc_sheet.res[2],view.merc_sheet.res[3]),92,428,296);
+    const auto notice=d2d::game::merc_item_message(view.merc_notice);
+    if(*notice)text(notice,92,455,296,28,true);
+    else text(act==1?"Bows only":act==2?"Spears / polearms / javelins":act==3?"One-handed swords / shields":"Swords only",92,455,296,28,true);
+    if(hover){auto lines=item_lines(scene,*hover,wearer.lvl,&wearer);draw_hover_text(f,scene,lines,hover_box[0],hover_box[0]+hover_box[2],hover_box[1]+hover_box[3],hover_box[1]);}
+}
