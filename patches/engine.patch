+// Snapshot the actual previous simulation tick using reusable compact storage.
+void Town::capture_motion(){
+    using M=d2mini::MotionSamples;
+    motion.begin(world.level);
+    const auto near=[&](float x,float y){return std::abs(x-world.player.x)<22&&std::abs(y-world.player.y)<22;};
+    for(const auto& m:world.fight.monsters)if(world.fight.mon_level==world.level&&near(m.unit.x,m.unit.y))motion.add(M::key(M::Monster,std::uint32_t(m.id)),m.unit.x,m.unit.y);
+    for(const auto& p:world.fight.pets)if(p.where==world.level&&near(p.monster.unit.x,p.monster.unit.y))motion.add(M::key(M::Pet,std::uint32_t(p.monster.id)),p.monster.unit.x,p.monster.unit.y);
+    if(world.fight.merc)motion.add(M::key(M::Merc,1),world.fight.merc->unit.x,world.fight.merc->unit.y);
+    if(world.fight.mon_level==world.level)for(auto& m:world.fight.missiles){
+        if(!m.render_id){m.render_id=next_motion_id++;if(!next_motion_id)++next_motion_id;}
+        if(near(m.x,m.y))motion.add(M::key(M::Missile,m.render_id),m.x,m.y);
+    }
+    if(!world.level)return;
+    const auto npcs=[&](const Level* level,const auto& states,float dx,float dy){
+        for(std::size_t i=0;i<level->npcs.size()&&i<states.size();++i)if(level->npcs[i].root=="monsters")motion.add(M::key(M::Npc,reinterpret_cast<std::uintptr_t>(&level->npcs[i])),states[i].x+dx,states[i].y+dy);
+    };
+    npcs(world.level,world.npc_states,0,0);
+    for(const auto& n:world.level->nearby)if(const auto p=world.other_npcs.find(n.level);p!=world.other_npcs.end())npcs(n.level,p->second,float(n.dx),float(n.dy));
+    motion.finish();
