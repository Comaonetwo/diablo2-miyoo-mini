+                if(!dead()&&character.stats.get(d2d::d2s::kLife)>0&&strongest(source,player.x,player.y)){auto& life=character.stats.values[d2d::d2s::kLife];const auto before=life;life=std::min(character.stats.values[d2d::d2s::kMaxLife],life+heal);healed|=life>before;}
+                if(merc&&merc->hit_points>0&&merc->mode!="DT"&&merc->mode!="DD"&&strongest(source,merc->unit.x,merc->unit.y)){const int before=merc->hit_points;merc->hit_points=std::min(merc_max_life(),merc->hit_points+(heal>>8));healed|=merc->hit_points>before;}
+                for(auto& pet:pets)if(pet_receiver(pet)){auto& m=pet.monster;const int before=m.hit_points;m.hit_points=std::min(m.stats.hit_points,m.hit_points+(heal>>8));healed|=m.hit_points>before;}
