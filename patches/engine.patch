+// Stat delivery from native BasicAura: strongest same skill, friendly target
+// stats only. Source formulas are evaluated once per refresh, not per pet/stat.
+void Fight::collect_allied(float x,float y,bool paladin,std::vector<std::pair<int,int>>& out)const{
+    out.clear();
+    const auto reaches=[&](const AlliedEmitter& e){const float dx=x-e.x,dy=y-e.y;return (paladin||!e.paladin)&&dx*dx+dy*dy<=e.radius*e.radius;};
+    for(std::size_t i=0;i<allied_emitters.size();++i){const auto& e=allied_emitters[i];if(!reaches(e))continue;bool replaced=false;
+        for(std::size_t j=0;j<allied_emitters.size();++j)if(j!=i){const auto& other=allied_emitters[j];if(other.skill==e.skill&&reaches(other)&&(other.level>e.level||(other.level==e.level&&j<i))){replaced=true;break;}}
+        if(replaced)continue;
+        for(const auto& [id,value]:e.stats)if(id>=0&&id!=6&&id!=110&&value){const auto at=std::ranges::find(out,id,[](const auto& p){return p.first;});if(at==out.end())out.emplace_back(id,value);else at->second+=value;}
+    }
+}
+void Fight::refresh_allied_auras(){
+    allied_emitters.clear();
+    const auto add=[&](const d2d::rules::Skill& row,int level,float x,float y,float radius,bool merc_owner,bool paladin){
+        if(level<=0||radius<0)return;AlliedEmitter e;e.skill=row.id;e.level=level;e.x=x;e.y=y;e.radius=radius;e.paladin=paladin;
+        const auto env=merc_owner?merc_calc_env():calc_env();
+        for(std::size_t k=0;k<e.stats.size();++k)e.stats[k]={row.aurastat[k],row.aurastat[k]>=0?d2d::rules::eval_calc(game_data->skills,row.aura_calc[k],env,row.id,level):0};
+        allied_emitters.push_back(e);
+    };
+    for(const auto& source:aura_sources)if(const auto* row=game_data->skills.get(source.skill);row&&row->srvdofunc==ServerDoFunction::kFriendlyAura){
+        const auto& unit=source.merc&&merc?merc->unit:player;if(!aura_reaches(source,unit.x,unit.y))continue;
+        const float radius=source.radius>=0?source.radius:float(d2d::rules::eval_calc(game_data->skills,row->aurarange,source.merc?merc_calc_env():calc_env(),row->id,source.level))/5;
+        add(*row,source.level,unit.x,unit.y,radius,source.merc,true);
+    }
+    for(const auto& spirit:pets){const auto& m=spirit.monster;const auto* row=game_data->skills.get(spirit.aura);
+        if(spirit.where!=level||!m.alive()||m.mode=="DT"||m.mode=="DD"||!row||row->srvdofunc!=ServerDoFunction::kFriendlyAura)continue;
+        const auto env=spirit.merc_owner?merc_calc_env():calc_env();const float radius=float(d2d::rules::eval_calc(game_data->skills,row->aurarange,env,row->id,spirit.aura_level))/5;
+        add(*row,spirit.aura_level,m.unit.x,m.unit.y,radius,spirit.merc_owner,false);
+    }
+    spirit_stats_cache[0].clear();spirit_stats_cache[1].clear();
+    if(!dead()&&character.stats.get(d2d::d2s::kLife)>0)collect_allied(player.x,player.y,false,spirit_stats_cache[0]);
+    if(merc&&merc->hit_points>0&&merc->mode!="DT"&&merc->mode!="DD")collect_allied(merc->unit.x,merc->unit.y,false,spirit_stats_cache[1]);
+    for(auto& pet:pets){
+        const int previous=pet_buff_stat(pet,d2d::d2s::kMaxLifePercent);const auto& m=pet.monster;
+        if(pet.where==level&&m.alive()&&m.mode!="DT"&&m.mode!="DD"&&m.type>=0&&!game_data->monsters.types[std::size_t(m.type)].no_aura)collect_allied(m.unit.x,m.unit.y,true,pet.allied_stats);else pet.allied_stats.clear();
+        if(previous!=pet_buff_stat(pet,d2d::d2s::kMaxLifePercent))pet_buffs(pet);
+    }
+    if(merc&&merc->hit_points>0)merc->hit_points=std::min(merc->hit_points,merc_max_life());
+}
+auto Fight::pet_attack_stats(const Pet& pet)const->d2d::rules::MonStats{
+    auto out=pet.monster.stats;
+    out.attack_fire_min+=pet_buff_stat(pet,d2d::d2s::kFireMinDamage);out.attack_fire_max+=pet_buff_stat(pet,d2d::d2s::kFireMaxDamage);
+    const int damage=pet_buff_stat(pet,d2d::d2s::kDamagePercent)+pet_debuff_stat(pet,d2d::d2s::kDamagePercent);
