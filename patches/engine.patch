+            if(!profile)profile=projected?casting_summon:summon_attack(*source,hand==5);
+            const bool valid=target>=0&&std::size_t(target)<monsters.size();const auto& unit=source->monster.unit;
+            ItemCast cast{p.skill,p.level,valid?monsters[std::size_t(target)].id:-1,2,unit.x,unit.y,valid?monsters[std::size_t(target)].unit.x:unit.x,valid?monsters[std::size_t(target)].unit.y:unit.y};
+            cast.pet=pet_id;cast.death=event==OnDeath;cast.summon=profile;cast.where=level;item_casts.push_back(std::move(cast));
+        }return;
+    }
+    const bool saved=owner==0&&projectile_procs&&(event==OnHit||event==OnKill);
+    const auto& list=saved?*projectile_procs:item_procs[std::size_t(owner)];if(list.empty())return;
+    const auto& items=owner?character.merc_items:character.items;int hand=0;
