+  static constexpr int icon_class[]{0,3,1,4};const int act=std::clamp(d2d::game::merc_act(scene,view.header),0,3);
+  const auto& icon=scene.class_icons[std::size_t(icon_class[act])];
+  if(icon.frames_per_direction()){const auto& image=icon.frame(0,0);if(image.width&&image.height)for(int y=0;y<30;++y)for(int x=0;x<30;++x){const auto index=image.pixels[std::size_t(y*image.height/30)*image.width+std::size_t(x*image.width/30)];if(index){const auto c=pal[index];auto*p=f.data()+((top+3+y)*800+15+x)*4;p[0]=c.r;p[1]=c.g;p[2]=c.b;}}}
