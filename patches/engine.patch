+d2d::rules::StatSum Fight::aura_stats(bool receiver_merc)const{
+    d2d::rules::StatSum out{};if(receiver_merc&&!merc)return out;const auto& unit=receiver_merc?merc->unit:player;
+    for(const auto& [id,value]:spirit_stats_cache[receiver_merc?1:0])if(id>=0&&std::size_t(id)<out.size())out[std::size_t(id)]+=value;
+    for(std::size_t i=0;i<aura_sources.size();++i){const auto& source=aura_sources[i];const auto* skill=game_data->skills.get(source.skill);if(!skill)continue;
+        const auto applies=[&](const AuraSource& a){return a.skill==source.skill&&(a.merc==receiver_merc||skill->srvdofunc==ServerDoFunction::kFriendlyAura)&&aura_reaches(a,unit.x,unit.y);};
