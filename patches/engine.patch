+// Native MonInferno schedules one flame per calc3 interval during calc2 frames.
+// Reuse the monster channel clock; firing charges belong to the AI action.
+bool Fight::pet_breath_tick(Pet& pet,std::uint32_t now_ms){
+    auto& m=pet.monster;
+    const auto* skill=game_data->skills.get(m.breath);
+    const auto* info=skill?skill_missile(*skill,true):nullptr;
+    if(!skill||!info||!m.alive()||pet.where!=level||now_ms>=m.breath_until||pet.target<0||std::size_t(pet.target)>=monsters.size()||!monsters[std::size_t(pet.target)].targetable()){
+        m.breath=-1;pet.cast=-1;return false;
+    }
+    if(now_ms<m.breath_next)return true;
+    const SummonScope cast_context(casting_summon,pet.cast_source);
+    const auto env=pet.cast_source?actor_env():pet.merc_owner?merc_calc_env():calc_env();
+    const auto calc=[&](const auto& formula){return d2d::rules::eval_calc(game_data->skills,formula,env,skill->id,pet.shot_level);};
+    const int interval=std::max(calc(skill->calc[2]),1);
+    m.breath_next=now_ms+std::uint32_t(interval)*40;
+    int reach=calc(skill->calc[0]);if(reach<=0)reach=info->param2+pet.shot_level-1;
+    const auto& foe=monsters[std::size_t(pet.target)].unit;
+    const float dx=foe.x-m.unit.x,dy=foe.y-m.unit.y,dist=std::max(std::hypot(dx,dy),.01f),speed=missile_speed(*info,pet.shot_level);
+    Missile shot{info,m.unit.x,m.unit.y,dx/dist*speed,dy/dist*speed,direction32(dx,dy),now_ms,now_ms+std::uint32_t(std::clamp(reach,1,255))*40,{}};
+    shot.friendly=true;shot.level=pet.shot_level;shot.item_actor=2;shot.owner=m.id;shot.summon_attack=pet.cast_source;
+    const auto owner=game_data->skills.by_name.find(info->skill);shot.skill=owner==game_data->skills.by_name.end()?skill->id:owner->second;
+    pending.push_back(std::move(shot));return true;
+}
