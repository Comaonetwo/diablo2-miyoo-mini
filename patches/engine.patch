+bool Fight::aura_reaches(const AuraSource& source,float x,float y)const{
+    if(source.merc?(!merc||merc->mode=="DT"||merc->mode=="DD"||merc->hit_points<=0):(dead()||character.stats.get(d2d::d2s::kLife)<=0))return false;
