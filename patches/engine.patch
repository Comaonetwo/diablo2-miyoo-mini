+namespace d2d::client {
+inline std::array<int,4> merc_panel_rect(int slot){
+    namespace b=d2d::d2s::body_location;
+    if(slot==b::kHead)return {211,164,58,58};
+    if(slot==b::kTorso)return {211,266,58,87};
+    if(slot==b::kRightArm)return {119,266,58,116};
+    if(slot==b::kLeftArm)return {303,266,58,116};
+    return {};
+}
+inline int merc_panel_slot_at(const Scene& scene,const d2d::d2s::Header& h,int x,int y){
+    for(int slot:{d2d::d2s::body_location::kHead,d2d::d2s::body_location::kTorso,d2d::d2s::body_location::kRightArm,d2d::d2s::body_location::kLeftArm}){
+        if(!d2d::game::merc_slot(scene,h,slot))continue;
+        const auto b=merc_panel_rect(slot);if(x>=b[0]&&x<b[0]+b[2]&&y>=b[1]&&y<b[1]+b[3])return slot;
+    }
+    return -1;
+}
