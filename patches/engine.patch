@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <array>
+#include <vector>
+namespace d2d::client {
+struct TownMapCell { int cel,x,y; };
+// Game.exe 1.14d FUN_004591a0: the town maps are tiled sheets,
+// not one centred frame. Coordinates anchor each tile at its bottom left.
+inline std::vector<TownMapCell> town_map_cells(int level,int file,int cx,int cy) {
+    const bool lut=level==40;
+    if(!lut&&level!=103)return {};
+    const int cols=lut?5:2,rows=lut?4:2,w=lut?160:136,h=lut?100:90;
+    const int x=(cx-cy)*8-(cols*w/2+(lut?53:-3));
+    const int y=(cx+cy)*4-rows*h/2-(lut?-81:-50);
+    constexpr std::array<int,11> skip{0,10,15,16,19,20,25,30,35,36,39};
+    std::vector<TownMapCell> out;
+    int cel=lut&&file!=1?20:0;
+    for(int row=0;row<rows;++row)for(int col=0;col<cols;++col,++cel){
+        bool blank=false;if(lut)for(int i:skip)blank|=cel==i;
+        if(!blank)out.push_back({cel,x+col*w,y+row*h});
+    }
+    return out;
+}
+}
