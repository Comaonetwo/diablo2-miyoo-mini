+// Authentic original missile art. This is visual only: do not consume the
+// combat RNG, deal damage, or change the drop/experience/death event order.
+void Fight::shatter(Monster& monster,std::uint32_t now_ms){
+    if(monster.shatter_visual)return;
+    monster.shatter_visual=true;monster.corpse_used=true;
+    if(std::abs(monster.unit.x-player.x)>14||std::abs(monster.unit.y-player.y)>14)return;
+    const auto shards=[](const Missile& m){return m.visual_only&&m.info&&m.info->name.starts_with("icebreak");};
+    int available=128-int(std::ranges::count_if(missiles,shards)+std::ranges::count_if(pending,shards));
+    static constexpr const char* pieces[]{"icebreaksmall","icebreakmedium","icebreaklarge"};
+    const auto make=[&](const char* name,float vx,float vy,int dir){
+        const auto it=game_data->missiles.find(name);if(it==game_data->missiles.end()||available<=0)return;
+        --available;const auto& info=it->second;
+        const auto duration=std::uint32_t(std::max(info.range*40,info.anim_len*640/std::max(info.anim_speed,1)));
+        Missile fragment{&info,monster.unit.x,monster.unit.y,vx,vy,dir,now_ms,now_ms+std::max(duration,40u),{}};
+        fragment.visual_only=true;pending.push_back(std::move(fragment));
+    };
+    // Eight fragments and smoke, bounded even in dense cold-damage fights.
+    // Positions use an ID-derived rotation so repeated deaths don't all line up.
+    const float rotation=float(unsigned(monster.id)%16)*.3926990817f;
+    for(int i=0;i<8;++i){const float angle=rotation+float(i)*.7853981634f;
+        const float speed=.45f+float(i%3)*.2f;const float vx=std::cos(angle)*speed,vy=std::sin(angle)*speed;
+        make(pieces[i%3],vx,vy,direction32(vx,vy));
+    }
+    make("icebreaksmoke",0,0,0);
+    static constexpr const char* sounds[]={"impact_shatter_1","impact_shatter_2","impact_shatter_3"};
+    cues.cue(sounds[unsigned(monster.id)%3],now_ms,monster.unit.x,monster.unit.y);
+}
