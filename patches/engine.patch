+void Fight::merc_conditions(Foe& foe,std::uint32_t now_ms,float elapsed){
+    if(!merc||merc->mode=="DT"||merc->hit_points<=0)return;
+    if(foe.poison>0&&foe.poison_ticks>0){const double rate=foe.poison/40.0/256.0;if(now_ms>=merc->poison_until||rate>=merc->poison_rate){merc->poison_rate=rate;merc->poison_until=now_ms+std::uint32_t(foe.poison_ticks)*40;}}
+    if(now_ms<merc->poison_until){merc->dot_acc+=merc->poison_rate*double(elapsed)*1000;const int loss=int(merc->dot_acc);merc->dot_acc-=loss;foe.damage+=loss;}
+    if(foe.chill_ticks>0)merc->chill_until=std::max(merc->chill_until,now_ms+std::uint32_t(foe.chill_ticks)*40);
+    if(foe.stun_ticks>0)merc->stun_until=now_ms+std::uint32_t(std::min(foe.stun_ticks,250))*40;
+}
