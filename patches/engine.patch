+void Fight::configure_trap(Monster& monster,const Level* where){
+    if(monster.type<0||std::size_t(monster.type)>=game_data->monsters.types.size())return;const int base=game_data->monsters.types[std::size_t(monster.type)].base;
+    if(!((base>=0x146&&base<=0x14a)||base==0x162||base==0x171))return;
+    int lvl=2;if(where&&where->id>=0&&std::size_t(where->id)<game_data->area_level.size())lvl=std::max(game_data->area_level[std::size_t(where->id)][std::size_t(character.expansion?std::clamp(game_difficulty,0,2):3)],1);
