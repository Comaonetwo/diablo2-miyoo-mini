+std::optional<d2d::dt1::Archive> GameData::tile_archive(std::string path) const {
+    for(auto& c:path) {if(c=='/')c='\\';if(c>='A'&&c<='Z')c+=('a'-'A');}
+    std::lock_guard lock(tile_cache->mutex);
+    if(const auto it=tile_cache->archives.find(path);it!=tile_cache->archives.end())return it->second;
+    const auto mode=tile_pixels?d2d::dt1::Pixels::compact:d2d::dt1::Pixels::skip;
+    auto stream=mpqs.open(path);if(!stream)return std::nullopt;
+    auto archive=tile_pixels?d2d::dt1::Archive::from_lazy_stream(std::move(*stream)):d2d::dt1::Archive::from_stream(*stream,mode);
+    tile_cache->archives.emplace(std::move(path),archive);return archive;
+}
