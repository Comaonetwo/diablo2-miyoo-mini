#!/bin/sh
set -eu
: "${D2_ZIG:?Set D2_ZIG to Zig 0.17.0}"
d2_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export ZIG_GLOBAL_CACHE_DIR="$d2_root/work/arm-global-cache"
export ZIG_LOCAL_CACHE_DIR="$d2_root/work/arm-audio-cache"
exec "$D2_ZIG" cc -target arm-linux-gnueabihf.2.7 -mcpu=cortex_a7 "$@"
